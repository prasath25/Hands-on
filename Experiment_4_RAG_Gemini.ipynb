## 1. Create a small knowledge base

Use a university scenario so students can understand the retrieval problem.
documents = [
    "The university library is open from 8 AM to 8 PM Monday to Friday. "
    "On weekends, the library is open from 9 AM to 5 PM.",

    "Students can borrow up to five books at a time. "
    "Books can normally be borrowed for fourteen days.",

    "The computer laboratory is located in Block B, second floor. "
    "It is open from 9 AM to 7 PM on weekdays.",

    "Students who lose their identity card should immediately report "
    "the loss to the student administration office.",

    "The university cafeteria operates from 8 AM to 6 PM. "
    "Breakfast is served until 10 AM and lunch is served from 12 PM."
]

for i, doc in enumerate(documents):
    print(f"[{i}] {doc}\n")
## 2. Generate Gemini embeddings

We use `gemini-embedding-001` because it supports separate embeddings for a list of texts and retrieval task types.
from google.genai import types
import numpy as np

EMBED_MODEL = "gemini-embedding-001"

doc_response = client.models.embed_content(
    model=EMBED_MODEL,
    contents=documents,
    config=types.EmbedContentConfig(
        task_type="RETRIEVAL_DOCUMENT",
        output_dimensionality=768,
    ),
)

doc_vectors = np.array([e.values for e in doc_response.embeddings], dtype=np.float32)

print("Number of documents:", len(doc_vectors))
print("Embedding dimensions:", doc_vectors.shape[1])
## 3. Semantic retrieval

For a real vector database, use FAISS/Chroma/etc. Here we deliberately use NumPy so students can see the retrieval logic.
def cosine_similarity(a, b):
    a = np.asarray(a)
    b = np.asarray(b)
    return float(np.dot(a, b) / (np.linalg.norm(a) * np.linalg.norm(b)))

def retrieve(query, k=2):
    query_response = client.models.embed_content(
        model=EMBED_MODEL,
        contents=query,
        config=types.EmbedContentConfig(
            task_type="RETRIEVAL_QUERY",
            output_dimensionality=768,
        ),
    )
    query_vector = np.array(query_response.embeddings[0].values, dtype=np.float32)

    scores = [
        cosine_similarity(query_vector, vector)
        for vector in doc_vectors
    ]

    ranked = np.argsort(scores)[::-1][:k]
    return [(int(i), scores[i], documents[i]) for i in ranked]

results = retrieve("How many books can I keep at one time?", k=2)

for i, score, doc in results:
    print(f"Score={score:.4f} | Document {i}")
    print(doc)
    print()
## 4. Build the RAG answer function
def rag_answer(question, k=2):
    retrieved = retrieve(question, k=k)

    context = "\n\n".join(
        f"[Source {rank}] {doc}"
        for rank, (_, _, doc) in enumerate(retrieved, start=1)
    )

    prompt = f"""
You are a university information assistant.

Answer the user's question using ONLY the supplied context.
If the answer is not contained in the context, say:
"I don't know based on the provided information."

Always cite the source numbers you used, for example [Source 1].

Context:
{context}

Question:
{question}
"""

    response = client.models.generate_content(
        model=MODEL,
        contents=prompt,
        config={"temperature": 0.1, "max_output_tokens": 200},
    )

    return response.text, retrieved

answer, retrieved = rag_answer("What are the library opening hours?")
print(answer)
## 5. Inspect every RAG stage

This debugging view is important for teaching.
def rag_debug(question):
    print("="*70)
    print("QUESTION")
    print(question)

    answer, retrieved = rag_answer(question)

    print("\nRETRIEVED CONTEXT")
    for rank, (i, score, doc) in enumerate(retrieved, start=1):
        print(f"\nSource {rank} | document={i} | score={score:.4f}")
        print(doc)

    print("\nFINAL GEMINI ANSWER")
    print(answer)

rag_debug("Where should I report a lost identity card?")
## 6. Hallucination / grounding test

Ask something that is NOT in the knowledge base.
rag_debug("Does the university provide free laptops to every student?")
### Discuss

A RAG system does not make the model's internal knowledge disappear. Instead, our prompt instructs the model to answer from retrieved context and admit when the provided information is insufficient.
## 7. Simple chunking demonstration

Real documents are usually split into smaller chunks before embedding.
long_text = """
The university was established in 1985. The computer science department
was established in 1992. The department offers undergraduate and
postgraduate programs. Students can participate in internships during
their final year. The university also provides a central library,
computer laboratories, sports facilities and student clubs.
"""

def chunk_text(text, chunk_size=35, overlap=5):
    words = text.split()
    chunks = []
    start = 0

    while start < len(words):
        end = min(start + chunk_size, len(words))
        chunks.append(" ".join(words[start:end]))
        if end == len(words):
            break
        start = end - overlap

    return chunks

chunks = chunk_text(long_text)

for i, chunk in enumerate(chunks):
    print(f"CHUNK {i}: {chunk}\n")
